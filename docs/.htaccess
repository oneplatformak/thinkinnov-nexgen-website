# ThinkInnov-NexGen — cPanel / Apache
Options -Indexes
ServerSignature Off

# Force HTTPS
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Custom 404
ErrorDocument 404 /404.html

# Old SPA-style URLs → real pages
RewriteCond %{QUERY_STRING} (^|&)page=about(&|$)
RewriteRule ^page\.html$ /about.html? [L,R=301]
RewriteCond %{QUERY_STRING} (^|&)page=plm(&|$)
RewriteRule ^page\.html$ /plm.html? [L,R=301]
RewriteCond %{QUERY_STRING} (^|&)page=services(&|$)
RewriteRule ^page\.html$ /services.html? [L,R=301]
RewriteCond %{QUERY_STRING} (^|&)page=digital-transformation(&|$)
RewriteRule ^page\.html$ /digital-transformation.html? [L,R=301]
RewriteCond %{QUERY_STRING} (^|&)page=products(&|$)
RewriteRule ^page\.html$ /products.html? [L,R=301]
RewriteCond %{QUERY_STRING} (^|&)page=solutions(&|$)
RewriteRule ^page\.html$ /solutions.html? [L,R=301]
RewriteCond %{QUERY_STRING} (^|&)page=industries(&|$)
RewriteRule ^page\.html$ /industries.html? [L,R=301]
RewriteCond %{QUERY_STRING} (^|&)page=behind-the-brand(&|$)
RewriteRule ^page\.html$ /behind-the-brand.html? [L,R=301]
RewriteCond %{QUERY_STRING} (^|&)page=careers(&|$)
RewriteRule ^page\.html$ /careers.html? [L,R=301]

# Legacy job / application URLs (numeric id → careers list; JS stubs handle slug mapping on GH Pages)
RewriteCond %{QUERY_STRING} (^|&)id=1(&|$)
RewriteRule ^jobdetails\.html$ /careers/01-tech-lead-teamcenter.html? [L,R=301]
RewriteCond %{QUERY_STRING} (^|&)id=1(&|$)
RewriteRule ^application\.html$ /apply.html?job=01-tech-lead-teamcenter [L,R=301]
